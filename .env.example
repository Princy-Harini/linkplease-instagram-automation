# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Server
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Local Docker or hosted PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkplease_db
# For testing with SQLite when PostgreSQL is not running:
# DATABASE_URL=sqlite:///./test_linkplease.db

# Redis Broker Configuration
REDIS_URL=redis://localhost:6379/0

# External Mock PseudoGram API
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
PSEUDOGRAM_API_KEY=your_pseudogram_api_key_here

# Security / Webhook Signature Verification
# Set to true to enforce HMAC-SHA256 signature verification on /webhook
VERIFY_WEBHOOK_SIGNATURE=true

# Reliability & Rate Limiting Settings
MAX_RETRIES=5
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60
RECONCILIATION_INTERVAL_SECONDS=3
RECONCILIATION_MAX_ATTEMPTS=10
